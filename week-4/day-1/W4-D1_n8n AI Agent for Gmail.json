        "jsCode": "\nconst items = $input.all();\n\nconst summaries = items.map((item, index) => {\n  const summary = String(item.json.output ?? \"\").trim();\n  return `${index + 1}. ${summary}`;\n});\n\nconst emailBody =\n  `Unread Email Summary\\n\\n` +\n  summaries.join(\"\\n\\n\") +\n  `\\n\\nTotal emails summarized: ${items.length}`;\n\nreturn [\n  {\n    json: {\n      subject: `Unread Email Summary - ${items.length} Emails`,\n      body: emailBody,\n      count: items.length\n    }\n  }\n];\n"
