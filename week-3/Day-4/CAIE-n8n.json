      "parameters": {
        "jsCode": "\nconst rows = $input.all().map(item => item.json);\n\n// Change this to your recipient email address\nconst recipient = \"your-email@example.com\";\n\nconst subject = `Student Enrollment Report - ${new Date().toLocaleDateString(\"en-GB\")}`;\n\nconst details = rows.map((student, index) => {\n  return `${index + 1}. Student Details\n   Student ID: ${student.Student_id ?? student.Student_Id ?? student.student_id ?? \"N/A\"}\n   Name: ${student.name ?? \"N/A\"}\n   Email: ${student.email ?? \"N/A\"}\n   Phone: ${student.phone ?? \"N/A\"}\n   Course: ${student.course ?? \"N/A\"}\n   Fee Paid: ${student.fee_paid === true ? \"Yes\" : student.fee_paid === false ? \"No\" : \"N/A\"}\n   City: ${student.city ?? \"N/A\"}\n   Enrollment Date: ${student.enrolled_date ?? \"N/A\"}\n   Email Valid: ${student.Email_valid ?? \"N/A\"}`;\n}).join(\"\\n\\n\");\n\nconst body = `Hello,\n\nPlease find below the student enrollment report.\n\nTotal Students: ${rows.length}\n\n${details}\n\nRegards,\nAutomated n8n Workflow`;\n\nreturn [{\n  json: {\n    to: recipient,\n    subject: subject,\n    body: body\n  }\n}];\n"
      },
